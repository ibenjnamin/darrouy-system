<section id="contacto">
  <div class="container">
    <div class="contact-box">
      <div class="contact-copy">
        <div class="section-label">Contacto</div>
        <h2 class="section-title">¿Tienes un proyecto? Conversemos.</h2>

        <p class="section-desc">
          Cuéntanos brevemente qué necesitas. Completa tus datos y envía tu consulta
          directamente desde esta página, sin abrir otra ventana.
        </p>

        <div class="contact-points">
          <div>
            <span class="point-icon">✓</span>
            <p><strong>Contacto directo</strong><br />La consulta llega a DARROUY.</p>
          </div>
          <div>
            <span class="point-icon">✓</span>
            <p><strong>Respuesta rápida</strong><br />Podremos responder directamente al correo ingresado.</p>
          </div>
          <div>
            <span class="point-icon">✓</span>
            <p><strong>Sin salir del sitio</strong><br />El formulario se envía en segundo plano.</p>
          </div>
        </div>
      </div>

      <form id="contactForm" class="contact-form">
        <div class="form-group">
          <label for="name">Nombre</label>
          <input
            id="name"
            name="name"
            type="text"
            placeholder="Tu nombre"
            autocomplete="name"
            required
          />
        </div>

        <div class="form-group">
          <label for="email">Correo</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="tu@correo.cl"
            autocomplete="email"
            required
          />
        </div>

        <div class="form-group">
          <label for="company">Empresa <span>(opcional)</span></label>
          <input
            id="company"
            name="company"
            type="text"
            placeholder="Nombre de tu empresa"
            autocomplete="organization"
          />
        </div>

        <div class="form-group">
          <label for="message">¿En qué podemos ayudarte?</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
          >Hola DARROUY, quisiera solicitar información sobre sus servicios de desarrollo y soluciones digitales.</textarea>
        </div>

        <button class="btn btn-primary submit-btn" id="submitButton" type="submit">
          <span class="button-text">Enviar consulta por correo</span>
          <span class="button-loading" hidden>Enviando...</span>
        </button>

        <button class="btn btn-whatsapp" id="whatsappButton" type="button">
          Contactar por WhatsApp
        </button>

        <p class="form-note">
          Tus datos serán utilizados únicamente para responder esta consulta.
        </p>
      </form>
    </div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite">
    <div class="toast-icon">✓</div>
    <div>
      <strong id="toastTitle">Correo enviado con éxito</strong>
      <span id="toastMessage">Gracias por contactarnos. Te responderemos a la brevedad.</span>
    </div>
  </div>
</section>

<script is:inline>
  const CONTACT_EMAIL = "Darrouy.System@gmail.com";
  const WHATSAPP_NUMBER = "56931195854";

  const form = document.getElementById("contactForm");
  const submitButton = document.getElementById("submitButton");
  const buttonText = submitButton?.querySelector(".button-text");
  const buttonLoading = submitButton?.querySelector(".button-loading");
  const whatsappButton = document.getElementById("whatsappButton");
  const toast = document.getElementById("toast");
  const toastTitle = document.getElementById("toastTitle");
  const toastMessage = document.getElementById("toastMessage");

  let toastTimer;

  function showToast(type, title, message) {
    if (!toast || !toastTitle || !toastMessage) return;

    toast.classList.remove("success", "error", "show");
    toast.classList.add(type);
    toastTitle.textContent = title;
    toastMessage.textContent = message;

    requestAnimationFrame(() => {
      toast.classList.add("show");
    });

    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove("show");
    }, 5000);
  }

  function setLoading(loading) {
    if (!submitButton || !buttonText || !buttonLoading) return;

    submitButton.disabled = loading;
    buttonText.hidden = loading;
    buttonLoading.hidden = !loading;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const name = document.getElementById("name")?.value.trim() || "";
    const email = document.getElementById("email")?.value.trim() || "";
    const company = document.getElementById("company")?.value.trim() || "";
    const message = document.getElementById("message")?.value.trim() || "";

    const payload = {
      name,
      email,
      company,
      message,
      _subject: `Nueva consulta DARROUY - ${name}`,
      _template: "table",
      _captcha: "false"
    };

    setLoading(true);

    try {
      const response = await fetch(
        `https://formsubmit.co/ajax/${CONTACT_EMAIL}`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(payload)
        }
      );

      const data = await response.json();

      if (!response.ok || data.success === "false" || data.success === false) {
        throw new Error(data.message || "No fue posible enviar el mensaje.");
      }

      showToast(
        "success",
        "Correo enviado con éxito",
        "Gracias por contactarnos. Te responderemos a la brevedad."
      );

      form.reset();

      const messageField = document.getElementById("message");
      if (messageField) {
        messageField.value =
          "Hola DARROUY SYSTEM, quisiera solicitar información sobre sus servicios de desarrollo y soluciones digitales.";
      }
    } catch (error) {
      console.error(error);

      showToast(
        "error",
        "No se pudo enviar el correo",
        "Inténtalo nuevamente o contáctanos por WhatsApp."
      );
    } finally {
      setLoading(false);
    }
  });

  whatsappButton?.addEventListener("click", () => {
    const text =
      "Hola DARROUY SYSTEM, quisiera solicitar información sobre sus servicios de desarrollo y soluciones digitales.";

    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
    window.open(url, "_blank", "noopener,noreferrer");
  });
</script>

