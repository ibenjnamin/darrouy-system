---
import "../styles/global.css";
const {
  title = "DARROUY | Desarrollo Web & Soluciones Digitales",
  description = "DARROUY desarrolla soluciones web, integraciones, automatización de procesos y sistemas digitales para empresas y organizaciones."
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#041020" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
